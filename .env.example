# Copie para .env.local e preencha. Nunca commite valores reais.
# (Por enquanto este arquivo documenta só a integração com o Instagram;
# as demais variáveis estão descritas no README.)

# ─── Instagram — spike de publicação (lib/instagram/README.md) ─────────────
# Conta profissional de TESTE usada por POST /api/instagram/test-publish.
# Preencha só no .env.local — o token nunca vai para arquivo versionado.
# ID da conta no Instagram: instagram_business_account.id de
# GET graph.facebook.com/v25.0/me/accounts?fields=name,instagram_business_account
INSTAGRAM_TEST_IG_USER_ID=
# Token de longa duração (~60 dias; troca do token curto via fb_exchange_token — ver README).
# EAA… = Facebook Login (graph.facebook.com, o caminho em uso) · IGAA… = Instagram Login (graph.instagram.com).
INSTAGRAM_TEST_ACCESS_TOKEN=
# Opcional: versão da Graph API (padrão v25.0).
INSTAGRAM_API_VERSION=
