# Copie para .env.local e preencha. Nunca commite valores reais.
# (Por enquanto este arquivo documenta só a integração com o Instagram;
# as demais variáveis estão descritas no README.)

# ─── Instagram — publicar carrosséis do Studio (lib/instagram/README.md) ───
# Conta de destino do botão "Publicar no Instagram" (por enquanto, uma conta só).
# Preencha só no .env.local — o token nunca vai para arquivo versionado.
# Token de longa duração (60 dias) da conta de teste.
# IGAA… = Instagram Login (graph.instagram.com, o caminho em uso) · EAA… = Facebook Login (graph.facebook.com).
# INSTAGRAM_TEST_ACCESS_TOKEN também é aceito como nome alternativo.
INSTAGRAM_ACCESS_TOKEN=
# Opcional com token IGAA: sem ele, o id vem de GET graph.instagram.com/me?fields=user_id,username.
# Se definido e diferente do /me, a rota recusa. Obrigatório com token EAA (ver README).
INSTAGRAM_TEST_IG_USER_ID=
# Opcional: versão da Graph API (padrão v25.0).
INSTAGRAM_API_VERSION=
# Segredo do cron que publica os agendados (/api/cron/instagram-publish).
# pg_cron/Make mandam em x-cron-secret; a Vercel Cron usa CRON_SECRET (Authorization: Bearer).
# Sem nenhum dos dois, o cron fica desligado.
INSTAGRAM_CRON_SECRET=
